{
  "name": "cast-evaluation-gas",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "test": "node --test tests/application.test.cjs",
    "dev": "node scripts/dev-server.cjs 8192",
    "test:browser": "playwright test",
    "format": "prettier --write \"src/*.{js,html,json}\" \"scripts/*.cjs\" \"tests/**/*.cjs\" playwright.config.cjs package.json",
    "format:check": "prettier --check \"src/*.{js,html,json}\" \"scripts/*.cjs\" \"tests/**/*.cjs\" playwright.config.cjs package.json"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.6.2"
  }
}
