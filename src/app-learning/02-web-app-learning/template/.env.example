# Copy to .env; never commit credentials. Values are literal, without inline comments.

# 01 Local application
APP_ENVIRONMENT=local
SERVER_PORT=8080
APP_DB_SCHEMA=app_template

# 02 Database
DB_HOST=YOUR_SESSION_POOLER_HOST
DB_PORT=5432
DB_NAME=postgres
SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=

# 03 Image storage
APP_IMAGES_ENABLED=false
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=template-post-images-dev

# 04 OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=20s

# 05 Render deployment only
RENDER_API_KEY=
RENDER_DB_SCHEMA=app_template_production
