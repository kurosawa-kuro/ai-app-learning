# Copy to .env and fill in the Dashboard connection values. Never commit .env.
# Values are literal: no variable expansion, command execution or inline comments.
DB_HOST=YOUR_SESSION_POOLER_HOST
DB_PORT=5432
DB_NAME=postgres
SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=

# Storage credentials: required to enable image posting or access existing images.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=template-post-images-dev
# Initial value for a NEW schema only. Change saved preferences in /admin/settings.
APP_IMAGES_ENABLED=false

APP_DB_SCHEMA=app_template
SERVER_PORT=8080
APP_ENVIRONMENT=local
APP_CONNECTION_LABEL=Supabase development
APP_ACCESS_MODE=local
# Public environment gate; use HTTPS and a secret of at least 20 characters.
APP_ACCESS_USER=starter
APP_ACCESS_PASSWORD=

# Deployment only: read by scripts/render.sh, never passed to the app. Render Account settings > API Keys.
RENDER_API_KEY=
RENDER_DB_SCHEMA=app_template_production

# Server-only Gemini credentials. Sending requires saved AI permission + explicit check.
GEMINI_API_KEY=
# Must also appear in the saved allow-list at /admin/ai. Changing this does not grant permission.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=20s
