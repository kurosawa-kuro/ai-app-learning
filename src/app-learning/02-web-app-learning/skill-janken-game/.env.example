# Copy to .env; never commit credentials. Values are literal, without inline comments.

# 01 Local application
APP_ENVIRONMENT=local
SERVER_PORT=8095
APP_DB_SCHEMA=skill_janken_game

# 02 Database
DB_HOST=YOUR_SESSION_POOLER_HOST
DB_PORT=5432
DB_NAME=postgres
SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=

# 03 Image storage
APP_IMAGES_ENABLED=false
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=skill-janken-game-images-dev

# 04 Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=20s

# 05 Render deployment only
RENDER_API_KEY=
RENDER_DB_SCHEMA=skill_janken_game_production

# demo: 固定AI応答。実AIはliveを明示
APP_AI_MODE=demo

# Render uses a separate schema and bucket; set these in its Dashboard.
# APP_DB_SCHEMA=skill_janken_game_render
# SUPABASE_STORAGE_BUCKET=skill-janken-game-images-render
